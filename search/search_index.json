{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u695a\u8fad\u6587\u4ef6\u5eab","text":"<p>\u6b61\u8fce\u4f86\u5230\u6211\u7684\u7b2c\u4e00\u500b Material for MkDocs \u7db2\u7ad9\uff01</p>"},{"location":"#_2","title":"\u6700\u65b0\u6587\u7ae0","text":"<p>\u9019\u662f\u9996\u9801\u5167\u5bb9\u3002</p>"},{"location":"jiu_ge_shan_gui/","title":"Jiu ge shan gui","text":"\u4e5d\u6b4c <p>\u539f\u70ba\u50b3\u8aac\u4e2d\u7684\u4e00\u7a2e\u9060\u53e4\u6b4c\u66f2\u7684\u540d\u7a31\uff0c\u5c48\u539f\u64da\u6c11\u9593\u796d\u795e\u6a02\u6b4c\u6539\u4f5c\u6216\u52a0\u5de5\u800c\u6210\uff0c\u5171\u5341\u4e00\u7bc7\u3002  </p> \u5c71\u9b3c <p>\u82e5\u6709\u4eba\u516e\u5c71\u4e4b\u963f\uff0c\u88ab\u859c\u8354\u516e\u5e36\u5973\u7f85\u3002 \u65e2\u542b\u7747\u516e\u53c8\u5b9c\u7b11\uff0c\u5b50\u6155\u4e88\u516e\u5584\u7a88\u7a95\u3002 \u4e58\u8d64\u8c79\u516e\u5f9e\u6587\u72f8\uff0c\u8f9b\u5937\u8eca\u516e\u7d50\u6842\u65d7\u3002 \u88ab\u77f3\u862d\u516e\u5e36\u675c\u8861\uff0c\u6298\u82b3\u99a8\u516e\u907a\u6240\u601d\u3002 \u4f59\u8655\u5e7d\u7bc1\u516e\u7d42\u4e0d\u898b\u5929\uff0c\u8def\u96aa\u96e3\u516e\u7368\u5f8c\u4f86\u3002 \u8868\u7368\u7acb\u516e\u5c71\u4e4b\u4e0a\uff0c\u96f2\u5bb9\u5bb9\u516e\u800c\u5728\u4e0b\u3002 \u6773\u51a5\u51a5\u516e\u7f8c\u665d\u6666\uff0c\u6771\u98a8\u98c4\u516e\u795e\u9748\u96e8\u3002 \u7559\u9748\u8129\u516e\u61ba\u5fd8\u6b78\uff0c\u6b72\u65e2\u664f\u516e\u5b70\u83ef\u4e88\u3002 \u63a1\u4e09\u79c0\u516e\u65bc\u5c71\u9593\uff0c\u77f3\u78ca\u78ca\u516e\u845b\u8513\u8513\u3002 \u6028\u516c\u5b50\u516e\u60b5\u5fd8\u6b78\uff0c\u541b\u601d\u6211\u516e\u4e0d\u5f97\u9592\u3002 \u5c71\u4e2d\u4eba\u516e\u82b3\u675c\u82e5\uff0c\u98f2\u77f3\u6cc9\u516e\u852d\u677e\u67cf\u3002 \u541b\u601d\u6211\u516e\u7136\u7591\u4f5c\u3002 \u9741\u586b\u586b\u516e\u96e8\u51a5\u51a5\uff0c\u733f\u557e\u557e\u516e\u53c8\u591c\u9cf4\u3002 \u98a8\u98af\u98af\u516e\u6728\u856d\u856d\uff0c\u601d\u516c\u5b50\u516e\u5f92\u96e2\u6182\u3002  \u3010\u8a3b\u91cb\u3011</p> <p>\u5c71\u9b3c\uff1a  </p> <ol> <li>\u5373\u4e00\u822c\u6240\u8aac\u7684\u5c71\u795e\uff0c\u56e0\u70ba\u672a\u7372\u5929\u5e1d\u6b63\u5f0f\u518a\u5c01\u5728\u6b63\u795e\u4e4b\u5217\uff0c\u6545\u7a31\u5c71\u9b3c\u3002  </li> <li>\u5973\u795e\u3002  </li> </ol> <p>\u5c71\u4e4b\u963f\uff08\u0113\uff09\uff1a  </p> <ol> <li>\u5c71\u9688\uff0c\u5c71\u7684\u5f4e\u66f2\u8655\u3002  </li> <li>\u5927\u5c71\u3002  </li> <li>\u5728\u6b64\u61c9\u53ef\u8996\u70ba\u5c71\u88cf\u7684\u67d0\u8655\u3002</li> </ol> <p>\u88ab\u859c\u8354\u516e\u5e36\u5973\u7f85</p> <p>\u88ab\uff08p\u012b\uff09\uff1a\u901a\u5047\u5b57\uff0c\u901a\u201c\u62ab\u201d\u3002 \u859c\u8354\u3001\u5973\u863f\uff1a\u7686\u8513\u751f\u690d\u7269\u3002  </p> <p>\u65e2\u542b\u7747\u516e\u53c8\u5b9c\u7b11</p> <p>\u542b\u7747\uff1a\u542b\u60c5\u800c\u8996\u3002\u7747\uff08d\u00ec\uff09\uff0c\u5fae\u8996\u3002 \u5b9c\u7b11\uff1a\u7b11\u5f97\u5f88\u7f8e\u3002  </p> <p>\u5b50\u6155\u4e88\u516e\u5584\u7a88\u7a95</p> <p>\u5b50\uff1a\u5c71\u9b3c\u5c0d\u6240\u611b\u6155\u7537\u5b50\u7684\u7a31\u547c\u3002 \u7a88\u7a95\uff1a\u5afa\u96c5\u7f8e\u597d\u8c8c\u3002  </p> <p>\u4e58\u8d64\u8c79\u516e\u5f9e\u6587\u72f8</p> <p>\u8d64\u8c79\uff1a\u50b3\u8aaa\u4e2d\u7684\u4ed9\u7378\u3002 \u5f9e\uff1a\u8ddf\u5f9e\u3002 \u6587\u72f8\uff1a\u6bdb\u8272\u6709\u82b1\u7d0b\u7684\u72f8\uff0c\u540c\u300c\u8c8d\u300d\uff0c\u4e00\u822c\u6307\u8c89\u6216\u8c79\u8c93\uff08\u77f3\u864e\uff09\u6216\u72f8\u8c93\uff1b\u6587\uff1a\u82b1\u7d0b\u3002    </p> <p>\u8f9b\u5937\u8eca\u516e\u7d50\u6842\u65d7</p> <p>\u8f9b\u5937\u8eca\uff1a\u4ee5\u8f9b\u5937\u6728\u70ba\u8eca\u3002 \u7d50\uff1a\u7de8\u7d50\u3002 \u6842\u65d7\uff0c\u4ee5\u6842\u70ba\u65d7\u3002  </p> <p>\u88ab\u77f3\u862d\u516e\u5e36\u675c\u8861</p> <p>\u77f3\u862d\u3001\u675c\u8605\uff1a\u7686\u9999\u8349\u540d\u3002  </p> <p>\u907a\uff08w\u00e8i\uff09\uff1a\u8d08\u3002  </p> <p>\u4f59\uff1a\u6211\u3002\u7bc1\uff1a\u7af9\u3002  </p> <p>\u8868\uff1a\u7368\u7acb\u7a81\u51fa\u4e4b\u8c8c\u3002  </p> <p>\u5bb9\u5bb9\uff1a\u5373\u201c\u6eb6\u6eb6\u201d\uff0c\u6c34\u6216\u7159\u6c23\u6d41\u52d5\u4e4b\u8c8c\u3002  </p> <p>\u6773\u51a5\u51a5\u516e\u7f8c\u665d\u6666</p> <p>\u6773\u51a5\u51a5\uff1a\u53c8\u5e7d\u6df1\u53c8\u660f\u6697\u3002 \u7f8c\uff1a\u8a9e\u52a9\u8a5e\u3002  </p> <p>\u795e\u9748\u96e8\uff1a\u795e\u9748\u964d\u4e0b\u96e8\u6c34\u3002    </p> <p>\u7559\u9748\u8129\u516e\u61ba\u5fd8\u6b78</p> <p>\u9748\u8129\uff1a\u6307\u795e\u5973\u3002 \u61ba\uff08d\u00e0n\uff09\uff1a\u5b89\u6a02\u3002  </p> <p>\u6b72\u65e2\u664f\u516e\u5b70\u83ef\u4e88</p> <p>\u664f\uff1a\u665a\u3002 \u83ef\u4e88\uff1a\u8b93\u6211\u50cf\u82b1\u4e00\u6a23\u7f8e\u9e97\u3002\u83ef\uff1a\u82b1\u3002  </p> <p>\u4e09\u79c0\uff1a\u829d\u8349\uff0c\u4e00\u5e74\u958b\u4e09\u6b21\u82b1\uff0c\u50b3\u8aac\u670d\u98df\u4e86\u80fd\u5ef6\u5e74\u76ca\u58fd\u3002  </p> <p>\u77f3\u78ca\u78ca\u516e\u845b\u8513\u8513</p> <p>\u78ca\u78ca\uff1a\u4e82\u77f3\u5806\u7a4d\u7684\u6a23\u5b50\u3002 \u845b\uff1a\u845b\u8349\u3002 \u8513\u8513\uff1a\u9023\u63a5\u4e0d\u65b7\u7684\u6a23\u5b50\u3002  </p> <p>\u516c\u5b50\uff1a\u4e5f\u6307\u795e\u5973\u3002  </p> <p>\u541b\u601d\u6211\u516e\u4e0d\u5f97\u9592\uff1a\u610f\u8b02\u541b\u5b50\u4e4b\u6240\u4ee5\u4e0d\u4f86\u76f8\u6703\uff0c\u662f\u56e0\u70ba\u6c92\u6709\u7a7a\u9592\u3002  </p> <p>\u675c\u82e5\uff1a\u9999\u8349\u3002  </p> <p>\u852d\u677e\u67cf\uff1a\u4f4f\u5728\u677e\u67cf\u6a39\u4e0b\u3002  </p> <p>\u7136\u7591\u4f5c\uff1a\u4fe1\u7591\u4ea4\u52a0\u3002\u7136\uff0c\u76f8\u4fe1\uff1b\u4f5c\uff0c\u8d77\u3002  </p> <p>\u9741\u586b\u586b\u516e\u96e8\u51a5\u51a5</p> <p>\u9741\uff1a\u540c\u201c\u96f7\u201d\u3002 \u586b\u586b\uff1a\u96f7\u8072\u3002 </p> <p>\u733f\u557e\u557e\u516e\u53c8\u591c\u9cf4 </p> <p>\u733f\uff1a\u5225\u672c\u5beb\u4f5c\u7328\u3002 \u557e\u557e\uff1a\u733f\u53eb\u8072\u3002\u72d6\uff08y\u00f2u\uff09\uff1a\u9577\u5c3e\u733f\u3002  </p> <p>\u98a8\u98af\u98af\u516e\u6728\u856d\u856d</p> <p>\u98af\u98af\uff1a\u98a8\u5439\u8072\u3002 \u856d\u856d\uff1a\u98a8\u5439\u843d\u8449\u7684\u8072\u97f3\u3002  </p> <p>\u96e2\uff1a\u901a\u201c\u7f79\u201d\uff0c\u906d\u53d7\u3002 </p> <p> \u3010\u767d\u8a71\u7ffb\u8b6f\u3011 \u597d\u50cf\u6709\u4eba\u5728\u90a3\u5c71\u4e2d\u7d93\u904e\uff0c\u662f\u6211\u8eab\u62ab\u859c\u8354\u8170\u675f\u5973\u863f\u3002 \u542b\u60c5\u6ce8\u8996\u5de7\u7b11\u591a\u9ebc\u512a\u7f8e\uff0c\u4f60\u6703\u7fa8\u6155\u6211\u7684\u59ff\u614b\u5a40\u5a1c\u3002 \u99d5\u4e58\u8d64\u8c79\u5f8c\u9762\u8ddf\u7740\u82b1\u72f8\uff0c\u8f9b\u5937\u6728\u8eca\u6842\u82b1\u7d2e\u8d77\u5f69\u65d7\u3002 \u662f\u6211\u8eab\u62ab\u77f3\u862d\u8170\u675f\u675c\u8861\uff0c\u6298\u679d\u9bae\u82b1\u8d08\u4f60\u804a\u8868\u76f8\u601d\u3002 \u6211\u5728\u5e7d\u6df1\u7af9\u6797\u4e0d\u898b\u5929\u65e5\uff0c\u9053\u8def\u8271\u96aa\u96e3\u884c\u7368\u81ea\u4f86\u9072\u3002 \u5b64\u8eab\u4e00\u4eba\u4f47\u7acb\u9ad8\u9ad8\u5c71\u5dd4\uff0c\u96f2\u9727\u6eb6\u6eb6\u8173\u4e0b\u6d6e\u52d5\u8212\u6372\u3002 \u767d\u665d\u660f\u660f\u6697\u6697\u5982\u540c\u9ed1\u591c\uff0c\u6771\u98a8\u98c4\u65cb\u795e\u9748\u964d\u4e0b\u96e8\u9ede\u3002 \u7b49\u5f85\u795e\u5973\u6021\u7136\u5fd8\u537b\u6b78\u53bb\uff0c\u5e74\u6f38\u8001\u8ab0\u8b93\u6211\u6c38\u5982\u82b1\u8c54\uff1f \u5728\u5c71\u9593\u63a1\u6458\u76ca\u58fd\u7684\u829d\u8349\uff0c\u5ca9\u77f3\u78ca\u78ca\u845b\u85e4\u56db\u8655\u76e4\u7e5e\u3002 \u62b1\u6028\u795e\u5973\u60b5\u7136\u5fd8\u537b\u6b78\u53bb\uff0c\u4f60\u60f3\u6211\u55ce\u96e3\u9053\u6c92\u7a7a\u4f86\u5230\u3002 \u5c71\u4e2d\u4eba\u5152\u5c31\u50cf\u82ac\u82b3\u675c\u82e5\uff0c\u77f3\u6cc9\u53e3\u4e2d\u98f2\u677e\u67cf\u982d\u4e0a\u906e\uff0c \u4f60\u60f3\u6211\u55ce\uff1f\u5fc3\u4e2d\u4fe1\u7591\u4ea4\u932f\u3002 \u96f7\u8072\u6efe\u6efe\u554a\u96e8\u52e2\u6fdb\u8499\uff0c\u733f\u9cf4\u557e\u557e\u554a\u7a7f\u900f\u591c\u5e55\u3002 \u98a8\u8072\u98bc\u98bc\u554a\u843d\u8449\u856d\u856d\uff0c\u601d\u5ff5\u5973\u795e\u554a\u5f92\u751f\u7169\u6182\u3002  </p>"},{"location":"shan_gui2/","title":"\u695a\u8fad\u00b7\u4e5d\u6b4c\u00b7\u5c71\u9b3c","text":"<p>\u5c0e\u8b80 \u300a\u5c71\u9b3c\u300b\u662f\u300a\u4e5d\u6b4c\u300b\u5341\u4e00\u7bc7\u4e4b\u4e00\uff0c\u63cf\u7e6a\u4e00\u4f4d\u7f8e\u9e97\u3001\u591a\u60c5\u800c\u53c8\u5b64\u7368\u7684\u5c71\u4e2d\u795e\u9748\uff08\u5c71\u9b3c\uff09\u3002\u5168\u8a69\u4ee5\u5c71\u9b3c\u7684\u8996\u89d2\uff0c\u7d30\u81f4\u5c55\u73fe\u4e86\u5979\u5f9e\u7cbe\u5fc3\u68b3\u599d\u3001\u9a45\u8eca\u8d74\u7d04\uff0c\u5230\u4e45\u7b49\u4e0d\u81f3\u3001\u5e7d\u6028\u611f\u50b7\u7684\u60c5\u611f\u8108\u7d61\u3002</p>"},{"location":"shan_gui2/#_2","title":"\ud83d\udcdc \u8a69\u6587\u8207\u8a3b\u91cb","text":"<p>!!! note \"\u6392\u7248\u8aaa\u660e\"     \u4e0b\u65b9\u5167\u6587\u4f7f\u7528\u5f15\u7528\u5340\u584a\uff08Blockquote\uff09\u5448\u73fe\u8a69\u6587\u539f\u6587\uff0c\u7dca\u96a8\u5176\u5f8c\u7684\u662f\u91cd\u9ede\u5b57\u8a5e\u8a3b\u91cb\u8207\u8b6f\u6587\u3002</p>"},{"location":"shan_gui2/#_3","title":"\u7b2c\u4e00\u6bb5\uff1a\u4e58\u8d64\u8c79\u516e\u5f9e\u6587\u72f8","text":"<p>\u82e5\u6709\u4eba\u516e\u5c71\u4e4b\u963f\uff0c\u88ab\u859b\u8354\u516e\u5e36\u5973\u863f\u3002 \u65e2\u542b\u7747\u516e\u53c8\u5b9c\u7b11\uff0c\u5b50\u6155\u4e88\u516e\u5584\u7a88\u7a95\u3002 \u4e58\u8d64\u8c79\u516e\u5f9e\u6587\u72f8\uff0c\u8f9b\u5937\u8eca\u516e\u7d50\u6842\u65d7\u3002 \u88ab\u77f3\u862d\u516e\u5e36\u675c\u8861\uff0c\u6298\u82b3\u99a8\u516e\u907a\u6240\u601d\u3002  </p> <p>\u3010\u91cd\u9ede\u8a3b\u91cb\u3011</p> <ul> <li>\u5c71\u4e4b\u963f\uff08\u0113\uff09\uff1a\u5c71\u8c37\u5f4e\u66f2\u4e4b\u8655\u3002</li> <li>\u88ab\uff08p\u012b\uff09\u859b\u8354\uff1a\u8eab\u62ab\u859c\u8354\uff08\u4e00\u7a2e\u9999\u8349\uff09\u3002\u88ab\uff0c\u540c\u300c\u62ab\u300d\u3002</li> <li>\u542b\u7747\uff08d\u00ec\uff09\uff1a\u542b\u60c5\u8108\u8108\u5730\u659c\u8996\u3002</li> <li>\u8f9b\u5937\u8eca\uff1a\u4ee5\u8f9b\u5937\u6728\uff08\u6728\u862d\uff09\u88fd\u6210\u7684\u8eca\u3002</li> <li>\u907a\uff08w\u00e8i\uff09\uff1a\u8d08\u9001\u3002</li> </ul>"},{"location":"shan_gui2/#_4","title":"\u7b2c\u4e8c\u6bb5\uff1a\u6b72\u65e2\u664f\u516e\u5b70\u83ef\u4e88","text":"<p>\u8655\u5e7d\u7bc1\u516e\u7d42\u4e0d\u898b\u5929\uff0c\u8def\u96aa\u96e3\u516e\u7368\u5f8c\u4f86\u3002 \u8868\u7368\u7acb\u516e\u5c71\u4e4b\u4e0a\uff0c\u96f2\u5bb9\u5bb9\u516e\u800c\u5728\u4e0b\u3002 \u6773\u51a5\u51a5\u516e\u7f8c\u665d\u6666\uff0c\u6771\u98a8\u98c4\u516e\u795e\u9748\u96e8\u3002 \u7559\u9748\u4fee\u516e\u6fb9\u5fd8\u6b78\uff0c\u6b72\u65e2\u664f\u516e\u5b70\u83ef\u4e88\uff1f  </p> <p>\u3010\u91cd\u9ede\u8a3b\u91cb\u3011</p> <ul> <li>\u5e7d\u7bc1\uff08hu\u00e1ng\uff09\uff1a\u5e7d\u6df1\u7684\u7af9\u6797\u3002</li> <li>\u96f2\u5bb9\u5bb9\uff1a\u96f2\u5f69\u6d41\u52d5\u98c4\u6d6e\u8c8c\u3002</li> <li>\u7f8c\uff08qi\u0101ng\uff09\uff1a\u695a\u8a9e\u767c\u8a9e\u8a5e\uff0c\u7121\u5be6\u7fa9\u3002</li> <li>\u795e\u9748\u96e8\uff08y\u00f9\uff09\uff1a\u795e\u9748\u964d\u4e0b\u96e8\u6c34\u3002\u96e8\uff0c\u5728\u6b64\u4f5c\u52d5\u8a5e\uff0c\u4e0b\u96e8\u3002</li> <li>\u9748\u4fee\uff1a\u6307\u6240\u601d\u5ff5\u7684\u795e\u660e\u6216\u611b\u4eba\u3002</li> <li>\u6b72\u65e2\u664f\uff1a\u4e00\u5e74\u5c07\u76e1\uff0c\u55bb\u6b72\u6708\u8e49\u8dce\u3001\u9752\u6625\u5c07\u901d\u3002</li> </ul>"},{"location":"shan_gui2/#_5","title":"\u7b2c\u4e09\u6bb5\uff1a\u98a8\u98af\u98af\u516e\u6728\u8449\u4e0b","text":"<p>\u63a1\u4e09\u79c0\u516e\u65bc\u5c71\u9593\uff0c\u77f3\u78ca\u78ca\u516e\u845b\u8513\u8513\u3002 \u6028\u516c\u5b50\u516e\u60b5\u5fd8\u6b78\uff0c\u541b\u601d\u6211\u516e\u4e0d\u5f97\u9591\u3002 \u5c71\u4e2d\u4eba\u516e\u82b3\u675c\u82e5\uff0c\u98f2\u77f3\u6cc9\u516e\u852d\u677e\u67cf\u3002 \u541b\u601d\u6211\u516e\u8ad7\u50ba\u5c65\uff1f \u98a8\u98af\u98af\u516e\u6728\u8449\u4e0b\uff0c\u601d\u516c\u5b50\u516e\u5f92\u96e2\u6182\u3002  </p> <p>\u3010\u91cd\u9ede\u8a3b\u91cb\u3011</p> <ul> <li>\u4e09\u79c0\uff1a\u9748\u829d\u8349\uff0c\u50b3\u8aaa\u4e00\u6b72\u4e09\u958b\u82b1\u3002</li> <li>\u8ad7\u50ba\uff08ch\u00ec\uff09\uff1a\u5931\u610f\u5931\u795e\u8c8c\u3002</li> <li>\u5f92\u96e2\u6182\uff1a\u5f92\u7136\u906d\u53d7\u6182\u6101\u3002\u96e2\uff0c\u901a\u300c\u7f79\u300d\uff0c\u906d\u9047\u3002</li> </ul>"},{"location":"shan_gui2/#_6","title":"\ud83d\udca1 \u8cde\u6790\u9ede\u64a5","text":"\u85dd\u8853\u7279\u8272\u89e3\u6790\uff08\u9ede\u64ca\u53ef\u6298\u758a\uff09  1. **\u795e\u4eba\u4e92\u5316**\uff1a\u8a69\u4e2d\u7684\u5c71\u9b3c\u65e2\u5177\u6709\u795e\u7684\u9748\u7570\uff08\u4e58\u8d64\u8c79\u3001\u99d5\u8f9b\u5937\u8eca\uff09\uff0c\u53c8\u5177\u5099\u4eba\u985e\u5c11\u5973\u7d14\u771f\u6df1\u60c5\u7684\u8c50\u5bcc\u5fc3\u7406\u3002 2. **\u9999\u8349\u7f8e\u4eba**\uff1a\u627f\u8972\u300a\u96e2\u9a37\u300b\u50b3\u7d71\uff0c\u4ee5\u859c\u8354\u3001\u5973\u863f\u3001\u77f3\u862d\u3001\u675c\u8861\u7b49\u9999\u8349\u896f\u8a17\u5c71\u9b3c\u7684\u9ad8\u6f54\u8207\u7f8e\u9e97\u3002 3. **\u666f\u7269\u896f\u8a17**\uff1a\u7d50\u5c3e\u300c\u98a8\u98af\u98af\u516e\u6728\u8449\u4e0b\u300d\u4ee5\u856d\u745f\u7684\u79cb\u666f\u70d8\u8a17\u843d\u5bde\u7121\u5948\u7684\u60c5\u611f\uff0c\u6975\u5177\u611f\u67d3\u529b\u3002"}]}